{
  "name": "better-auth-dbsc",
  "version": "0.1.1",
  "description": "Device Bound Session Credentials (DBSC) plugin for Better Auth: bind sessions to a device key so stolen cookies stop working.",
  "keywords": [
    "better-auth",
    "better-auth-plugin",
    "cookie-theft",
    "dbsc",
    "device-bound-session-credentials",
    "security",
    "session"
  ],
  "homepage": "https://github.com/helixnebulatech/better-auth-dbsc#readme",
  "bugs": {
    "url": "https://github.com/helixnebulatech/better-auth-dbsc/issues"
  },
  "license": "MIT",
  "author": "Helix Nebula (https://helixnebula.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helixnebulatech/better-auth-dbsc.git",
    "directory": "packages/better-auth-dbsc"
  },
  "source": "./src/index.ts",
  "files": [
    "dist/**/*",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "!src/**/__fixtures__",
    "CHANGELOG.md",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "del-cli dist && tsdown",
    "build:watch": "del-cli dist && tsdown --watch",
    "check-types": "tsrs --noEmit",
    "publint": "publint",
    "test": "bun run test:node && bun run test:edge",
    "test:watch": "vitest --config vitest.node.config.ts",
    "test:node": "vitest --config vitest.node.config.ts --run",
    "test:edge": "vitest --config vitest.edge.config.ts --run",
    "test:e2e": "node e2e/chrome.e2e.mjs && node e2e/chrome-sso.e2e.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0"
  },
  "devDependencies": {
    "@better-auth/core": "1.7.18",
    "@edge-runtime/vm": "5.0.0",
    "@types/node": "22.20.5",
    "better-auth": "1.7.18",
    "del-cli": "8.0.1",
    "playwright": "1.65.0",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@better-auth/core": "^1.7.18",
    "better-auth": "^1.7.18"
  },
  "engines": {
    "node": ">=22"
  }
}
